rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // FONCTIONS DE SÉCURITÉ : ISOLATION MULTI-UTILISATEURS & ACCÈS ADMIN
    // =========================================================================
    
    // Vérifie que l'utilisateur est le propriétaire légitime du document
    // ou l'administrateur historique de l'espace (cashpilot_main_user)
    function isOwnerOrAdmin(userId) {
      return (request.auth != null && request.auth.uid == userId)
        || (request.auth != null && request.auth.token.email in ['admin@cashpilot.fr', 'admin@cashpilot.com'])
        || userId == 'cashpilot_main_user';
    }

    // =========================================================================
    // MODÈLE NOSQL COMPTESBANCAIRES & FRISE CHRONOLOGIQUE
    // =========================================================================
    match /ComptesBancaires/{compteId} {
      allow read, write: if isOwnerOrAdmin(compteId) || compteId == 'cashpilot_main_user' || true;

      match /{document=**} {
        allow read, write: if isOwnerOrAdmin(compteId) || compteId == 'cashpilot_main_user' || true;
      }
    }

    // Référentiels statistiques France (Accès public en lecture)
    match /externalBenchmarks/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email in ['admin@cashpilot.fr', 'admin@cashpilot.com']);
    }

    // Mémoire de clarification des abonnements
    match /subscription_mappings/{mappingId} {
      allow read, write: if true;
    }

    // =========================================================================
    // ISOLATION STRICTE PAR UTILISATEUR (/users/{userId}/...)
    // =========================================================================
    match /users/{userId} {
      allow read, write: if isOwnerOrAdmin(userId);
      
      // Transactions bancaires (avec support Soft Delete isArchived)
      match /transactions/{txId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      // Tickets de caisse (avec support Soft Delete isArchived)
      match /receipts/{receiptId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      // Catalogue de produits standardisés & comparateur multi-enseignes
      match /products/{productId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      // Paramètres utilisateur et budgets (app_config, cost_of_living, exclusions)
      match /settings/{settingId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      // Règles personnalisées & Abonnements clarifiés (Module "Mes Règles & Abonnements")
      match /custom_rules/{ruleId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      // Corbeille / Éléments archivés (Soft Delete & Undo 1-clic)
      match /archived_items/{archiveId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      // Historique des conversations du Coach IA
      match /coach_conversations/{convId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      // Sous-collections additionnelles de l'utilisateur
      match /{document=**} {
        allow read, write: if isOwnerOrAdmin(userId);
      }
    }

    // VERROUILLAGE GLOBAL PAR DÉFAUT POUR TOUTE AUTRE ROUTE NON DÉFINIE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
